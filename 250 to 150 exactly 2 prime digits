public class Main {

    public static int san(int a, int b) {

        int big = Math.max(a, b);
        int small = Math.min(a, b);

        int lcm = big;

        while (lcm % small != 0) {
            lcm = lcm + big;
        }

        return lcm;
    }

    public static void main(String[] args) {

        int[] a = {8, 10, 4, 15, 12, 18, 20};

        int lcm = a[0];

        for (int i = 1; i < a.length; i++) {
            lcm = san(lcm, a[i]);
        }

        System.out.println("THE LCM IS " + lcm);
    }
}
