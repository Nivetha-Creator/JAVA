public class Main {
    public static void main(String[] args) {

        int count = 0;

        for (int i = 150; i <= 250; i++) {

            int n = i;
            int primeCount = 0;

            while (n != 0) {
                int d = n % 10;

                if (d == 2 || d == 3 || d == 5 || d == 7) {
                    primeCount++;
                }

                n = n / 10;
            }

            if (primeCount == 2) {
                count++;
                System.out.println(i);
            }
        }

        System.out.println("Total = " + count);
    }
}
