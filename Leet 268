import java.util.*;

public class Main {
    public static void main(String[] args) {

        int[] nums = {3, 0, 1};

        int n = nums.length;
        int result = n;

        for (int i = 0; i < n; i++) {
            result = result ^ i ^ nums[i];
        }

        System.out.println(result);
    }
}
