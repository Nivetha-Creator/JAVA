import java.util.Arrays;

public class Main {

    public static void main(String[] args) {

        int[] digits = {9, 9, 9};

        int n = digits.length;

        for (int i = n - 1; i >= 0; i--) {

            if (digits[i] < 9) {
                digits[i]++;
                System.out.println(Arrays.toString(digits));
                return;
            }

            digits[i] = 0;
        }

        int b = n + 1;

        int[] result = new int[b];

        result[0] = 1;

        System.out.println(Arrays.toString(result));
    }
}
